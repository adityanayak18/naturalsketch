# Free keys:
#   Gemini      https://aistudio.google.com/apikey
#   Groq        https://console.groq.com/keys
#   OpenRouter  https://openrouter.ai/settings/keys
# Any one key is enough; with all three, each step falls back across providers.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Supabase Postgres: Project > Connect > "Session pooler" connection string (without the password),
# and the database password on its own line (no URL-encoding needed).
DATABASE_URL=postgresql://postgres.<project-id>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_PASSWORD=

# Optional: override a step's model chain (tasks: VISION, PLAN, CODE, CHAT), e.g.
# NS_CHAIN_CODE=gemini:gemini-3.5-flash,openrouter:openrouter/free

# ---- Deploying to a server (Render, Railway, Fly...) ----
# Listen on all interfaces; most hosts also set PORT for you.
# HOST=0.0.0.0
# Two domains pointing at the same server: one for the builder, one for the generated apps.
# NS_APP_ORIGIN=https://naturalsketch.example.com
# NS_PREVIEW_ORIGIN=https://naturalsketch-apps.example.com

# ---- Accounts (Supabase Auth) ----
# The publishable/anon key from Supabase > Project Settings > API Keys. Leave empty for local
# single-user mode. SUPABASE_URL is worked out from DATABASE_URL; set it only if that fails.
# SUPABASE_ANON_KEY=
# SUPABASE_URL=https://<project-id>.supabase.co
# Your own sign-in email(s), comma-separated: no daily limit, and owner of projects made before accounts.
# NS_ADMIN_EMAIL=
# Builds + chat edits per account per day (0 = unlimited).
# NS_DAILY_LIMIT=20

# Encrypts the AI keys that users add to their accounts. Optional: without it the database
# password is used to derive the encryption key. Set it once and don't change it.
# NS_SECRET=
